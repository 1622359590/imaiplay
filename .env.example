SERVER_PORT=8080
APP_NAME=imaiplay
APP_VERSION=0.1.0

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
# PostgreSQL password
DB_PASSWORD=
DB_NAME=imaiplay
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25

# Required: generate with `openssl rand -hex 32`
JWT_SECRET=

# Comma-separated browser origins allowed by the API
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175

STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./uploads
STORAGE_LOCAL_URL=http://localhost:8080/uploads

# Encrypted local file paths for SMS and storage secrets
SMS_CONFIG_FILE=.imaiplay-sms.json
STORAGE_CONFIG_FILE=.imaiplay-storage.json

# In-process authentication rate limit
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60

LOG_LEVEL=info
LOG_FORMAT=json
